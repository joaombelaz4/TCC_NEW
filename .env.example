# Copie este arquivo para ".env" e preencha com valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

PORT=3000

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=tcc

# Use uma string longa e aleatória em produção (ex: gerada com `openssl rand -hex 32`)
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=7d
